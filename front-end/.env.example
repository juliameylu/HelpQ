# Supabase (required for auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public app URL for auth email links (must match Supabase Auth → URL configuration)
VITE_SITE_URL=http://127.0.0.1:5173

# Optional. In development, leave unset to use Vite's proxy to the API server
# (run backend: npm run start --workspace=@helpq/express-backend).
# VITE_API_URL=http://127.0.0.1:3001
