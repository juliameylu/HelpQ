# HelpQ Frontend — Environment Variables
# Copy to frontend/.env.local and fill in the real values.

# ── Supabase (required for auth) ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Public app URL (must match Supabase Auth → URL configuration) ─────────────
# Development default: http://127.0.0.1:5173
# Production: your deployed Azure Static Web App URL
VITE_SITE_URL=http://127.0.0.1:5173

# ── Backend API URL ───────────────────────────────────────────────────────────
# Leave UNSET in development — Vite proxies /api → http://127.0.0.1:3001
# In production, set this to your deployed Azure App Service backend URL:
# VITE_API_URL=https://helpq-b3cqcxbsdse7avbm.westus3-01.azurewebsites.net
